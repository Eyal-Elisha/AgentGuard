# Logs
*.log

# Legacy local-only proxy env file (unused by current config flow)
backend/proxy/.env
.agentguard/
.env
backend/.env
backend/agentguard.db

# Offline eval pipeline outputs (scripts/ commits, but artifacts/data are local).
# Each row carries full page HTML, so these run multiple GB — never commit them.
runs/
data/*.jsonl
# ...except the small committed samples, so the smoke test and the demo run on
# a fresh clone without downloading a corpus.
!data/smoke.jsonl
!data/demo_sample.jsonl
data/phreshphish/
# Any trainset directory, however the corpora were mixed, not just the first one.
data/semantic_train*/
# Experiment models live in data/; only the artifacts under backend/ are shipped.
data/*.pkl
!data/smoke.jsonl
# Local model backups. The tracked .pkl under backend/ carries the real
# artifact and its history; a snapshot taken before retraining is local only,
# whatever suffix it was given.
*.pkl.bak
# Any snapshot taken before retraining, whatever suffix it was given.
*.pkl.[A-Za-z0-9_]*
# Downloaded corpora and cached benchmark id lists: gigabytes, all re-fetchable.
data/kaggle/
data/benchmark_ids/

# Demo output: real captured pages written by scripts/demo_live.py --save
demo_out/
