# Template: Copy this file to `.env` and fill in values.

# The base URL prefix for API calls
VITE_API_BASE_URL=

# The backend server URL for the Vite dev proxy
VITE_BACKEND_URL=

# Host shown in each agent's endpoint on the Guard screen. The port beside it
# comes from the backend, which allocates one per agent.
VITE_PROXY_HOST=127.0.0.1